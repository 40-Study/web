  { id: 'delete', label: 'Delete', icon: icons.delete },
  { id: 'shape', label: 'Shape', icon: icons.shape },
  { id: 'edit', label: 'Edit', icon: icons.edit },
  { id: 'comment', label: 'Comment', icon: icons.comment },
  { id: 'upload', label: 'Share', icon: icons.upload },
