/**
 * Simple confetti animation using CSS
 */
function Confetti() {
  const colors = [
    "bg-yellow-400",
    "bg-pink-400",
    "bg-blue-400",
    "bg-green-400",
    "bg-purple-400",
    "bg-orange-400",
  ];

  const particles = Array.from({ length: 50 }, (_, i) => ({
    id: i,
    color: colors[i % colors.length],
    left: `${Math.random() * 100}%`,
    delay: `${Math.random() * 0.5}s`,
    duration: `${1 + Math.random() * 1}s`,
    size: Math.random() > 0.5 ? "w-2 h-2" : "w-1.5 h-3",
  }));

  return (
    <>
      {particles.map((particle) => (
        <div
          key={particle.id}
          className={cn(
            particle.color,
            particle.size,
            "absolute rounded-sm opacity-80"
          )}
          style={{
            left: particle.left,
            top: "-10px",
            animation: `confetti-fall ${particle.duration} ease-out ${particle.delay} forwards`,
          }}
        />
      ))}
      <style jsx>{`
        @keyframes confetti-fall {
          0% {
            transform: translateY(0) rotate(0deg);
            opacity: 1;
          }
          100% {
            transform: translateY(400px) rotate(720deg);
            opacity: 0;
          }
        }
      `}</style>
    </>
  );
}
</file>

