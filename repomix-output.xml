"use client";
import { memo } from "react";
import type { Theme, Language } from "./types";

interface Props {
  T: Theme;
  dark: boolean;
  currentPath: string;
  lang: Language;
  lineCount: number;
  setThemeKey: (fn: (k: string) => string) => void;
}

const StatusBar = memo(({ T, dark, currentPath, lang, lineCount, setThemeKey }: Props) => (
  <div
    style={{
