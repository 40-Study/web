            <h3 style={{
              margin: '0 0 8px',
              fontSize: '17px',
              fontWeight: 700,
              color: '#fff',
            }}>
              {alertModal.title}
            </h3>
            <p style={{
              margin: '0 0 24px',
              fontSize: '13px',
              color: 'rgba(255,255,255,0.5)',
              lineHeight: 1.6,
            }}>
              {alertModal.message}
