        <CardContent className="p-4">
          <div className="flex items-center gap-2 mb-4">
            <span className="text-lg">💰</span>
            <h3 className="font-medium">Cấu hình giá</h3>
          </div>
          <div className="grid grid-cols-2 gap-4">
            <Card
