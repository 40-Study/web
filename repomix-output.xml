            sizes[size],
            "transition-all duration-500 ease-out"
          )}
          style={{ width: `${clampedValue}%` }}
          role="progressbar"
          aria-valuenow={clampedValue}
          aria-valuemin={0}
          aria-valuemax={100}
        />
      </div>
      {showLabel && (
        <span className="text-xs text-muted-foreground mt-1">
          {Math.round(clampedValue)}%
        </span>
      )}
    </div>
  );
}
</file>

