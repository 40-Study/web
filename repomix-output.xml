        </div>
      )}

      {/* Assignment work overlay */}
      {activeAssignment && currentUserId && (
        <AssignmentWorkOverlay
          assignmentId={activeAssignment.assignment_id}
          title={activeAssignment.title}
          userId={currentUserId}
