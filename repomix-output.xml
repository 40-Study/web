}

export interface UpdateProfileDTO {
  username?: string;
  full_name?: string;
  phone?: string;
  date_of_birth?: string;
  bio?: string;
  avatar_url?: string;
}

export interface TokenResponse {
  message: string;
  data: {
    access_token: string;
    refresh_token?: string;
    expires_in: number;
  };
}

export interface Device {
  device_id: string;
  device_name: string;
  logged_in_at: string;
  ip_address?: string;
