# Repo này dùng npm public registry cho MỌI package.
#
# Lý do cần file này: một số máy trong team có `scope=<private-scope>` trong
# ~/.npmrc (phục vụ project khác). Khi đó npm gửi mọi scoped package
# (@playwright/*, @testing-library/*, @vitejs/*...) sang private registry đó
# và fail với HTTP 530. Dòng dưới ghim lại registry cho repo này.
#
# KHÔNG bao giờ đặt _authToken vào file này — nó được commit vào git.
registry=https://registry.npmjs.org/
scope=
