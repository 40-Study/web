NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Domain production — dùng cho sitemap.xml, robots.txt, canonical và OpenGraph.
# Thiếu biến này thì URL ảnh OG tương đối sẽ hỏng khi share link ra ngoài.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LiveKit configuration
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# E2E (Playwright) — chỉ cần khi chạy `npm run test:e2e`.
# Thiếu 2 biến dưới thì test đăng nhập thật tự động skip, không fail.
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=
E2E_PASSWORD=
