# DEV: dùng `localhost` (KHÔNG dùng 127.0.0.1) và cổng 5001 cho backend.
# - Cookie phiên (accessToken/rfToken) gắn với host của trang. Trang mở ở http://localhost:3000 mà WebSocket
#   trỏ 127.0.0.1 thì trình duyệt không gửi cookie -> handshake /api/ws trả 401, thông báo/chat không realtime
#   (QA vòng 2 F-01). Giữ API/WS cùng host với trang. src/lib/ws-url.ts tự căn localhost <-> 127.0.0.1 và
#   cảnh báo trong console, nhưng cấu hình đúng từ đầu vẫn là cách sạch nhất.
# - Cổng 5000 trên macOS bị AirPlay Receiver (AirTunes) chiếm và trả 403, nên đặt backend `PORT=5001`
#   (backend/.env) và trỏ web về 5001.
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Backend mà Next proxy (/api/*) chuyển tiếp tới ở phía server. Cùng host:port với NEXT_PUBLIC_API_URL.
BACKEND_URL=http://localhost:5001

# WebSocket endpoint cho realtime notification — PHẢI trỏ thẳng backend, không
# đi qua /api same-origin proxy (route.ts dùng axios nên không upgrade WS được).
# Xem src/hooks/use-notification-socket.ts (H6). Bỏ trống thì suy từ NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=ws://localhost:5001/api/ws

# Domain production — dùng cho sitemap.xml, robots.txt, canonical và OpenGraph.
# Thiếu biến này thì URL ảnh OG tương đối sẽ hỏng khi share link ra ngoài.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Thông tin ngân hàng tĩnh hiển thị cho user chuyển khoản (mua khóa học,
# mua xu). Backend đọc cùng thông tin này từ MB_BANK_NAME/... (server-side,
# xem internal/service/payment_service.go#getBankTransferInfoFromEnv) — giá
# trị ở đây PHẢI khớp giá trị thật backend đang dùng, hỏi backend/devops lấy
# giá trị production. Đây là thông tin công khai (in trên hoá đơn/QR), không
# phải secret.
NEXT_PUBLIC_BANK_NAME=MB Bank
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000
NEXT_PUBLIC_BANK_ACCOUNT_NAME=CONG TY 40STUDY

# LiveKit configuration
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# E2E (Playwright) — chỉ cần khi chạy `npm run test:e2e`.
# Thiếu 2 biến dưới thì test đăng nhập thật tự động skip, không fail.
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=
E2E_PASSWORD=
